# OpenClaw VPS Environment Variables
# Copy this to /root/.openclaw/.env and fill in your values

# Gateway auth token — generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Venice AI inference key — get from https://venice.ai/settings/api
# Make sure your account has credits!
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.venice.ai/v1
OPENAI_API_BASE=https://api.venice.ai/v1

# Telegram bot token — get from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID (for owner commands)
# Find it by messaging @userinfobot on Telegram
OPENCLAW_OWNER_TELEGRAM_ID=telegram:YOUR_TELEGRAM_USER_ID

TZ=UTC
