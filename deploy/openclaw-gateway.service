[Unit]
Description=OpenClaw Gateway (Venice AI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root
EnvironmentFile=/root/.openclaw/.env
Environment="PATH=/root/.nvm/versions/node/v22.22.3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/root/.nvm/versions/node/v22.22.3/bin/openclaw gateway --bind lan --port 18789
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3
SuccessExitStatus=78
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openclaw-gateway

[Install]
WantedBy=multi-user.target
