{
  agents: {
    defaults: {
      workspace: "/root/.openclaw/workspace",
      skipBootstrap: true,
      model: {
        // Model refs use the format provider-id/model-id.
        // Other Venice AI models you can switch to:
        // venice-openai/llama-3.3-70b
        // venice-openai/mistral-31-24b
        // venice-openai/qwen-2.5-vl
        primary: "venice-openai/venice-uncensored",
      },
    },
    list: [
      {
        id: "main",
        default: true,
        name: "OpenClaw",
        identity: {
          name: "OpenClaw",
          theme:
            "You are OpenClaw, a personal AI assistant. The user communicates in natural human language. Understand their intent and execute the appropriate skills and tools.",
          emoji: "🦞",
        },
      },
    ],
  },

  gateway: {
    mode: "local",
    bind: "lan",
    port: 18789,
    auth: {
      mode: "token",
      token: { source: "env", provider: "default", id: "OPENCLAW_GATEWAY_TOKEN" },
    },
    controlUi: {
      enabled: true,
    },
  },

  channels: {
    telegram: {
      enabled: true,
      dmPolicy: "open",
      allowFrom: ["*"],
      historyLimit: 50,
      linkPreview: true,
      streaming: "block",
      actions: {
        reactions: true,
        sendMessage: true,
      },
    },
  },

  models: {
    mode: "replace",
    providers: {
      "venice-openai": {
        api: "openai-completions",
        auth: "api-key",
        apiKey: { source: "env", provider: "default", id: "OPENAI_API_KEY" },
        authHeader: true,
        baseUrl: "https://api.venice.ai/v1",
        models: [
          {
            id: "venice-uncensored",
            name: "Venice Uncensored",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 32000,
            maxTokens: 8192,
          },
          {
            id: "llama-3.3-70b",
            name: "Llama 3.3 70B",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 128000,
            maxTokens: 8192,
          },
          {
            id: "mistral-31-24b",
            name: "Mistral 31 24B",
            reasoning: true,
            input: ["text", "image"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 128000,
            maxTokens: 8192,
          },
          {
            id: "qwen-2.5-vl",
            name: "Qwen 2.5 VL",
            reasoning: true,
            input: ["text", "image"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 128000,
            maxTokens: 8192,
          },
          {
            id: "dolphin-2.9.2-qwen2-72b",
            name: "Dolphin 2.9.2 Qwen2 72B",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 128000,
            maxTokens: 8192,
          },
        ],
      },
    },
  },

  plugins: {
    enabled: true,
  },

  skills: {
    load: {
      extraDirs: ["/root/.openclaw/skills"],
      watch: true,
      watchDebounceMs: 250,
    },
    install: {
      nodeManager: "pnpm",
    },
    entries: {
      "ai-and-llms": { enabled: true },
      "apple-apps-and-services": { enabled: true },
      "browser-and-automation": { enabled: true },
      "calendar-and-scheduling": { enabled: true },
      "clawdbot-tools": { enabled: true },
      "cli-utilities": { enabled: true },
      "coding-agents-and-ides": { enabled: true },
      communication: { enabled: true },
      "data-and-analytics": { enabled: true },
      "devops-and-cloud": { enabled: true },
      gaming: { enabled: true },
      "git-and-github": { enabled: true },
      "health-and-fitness": { enabled: true },
      "image-and-video-generation": { enabled: true },
      "ios-and-macos-development": { enabled: true },
      "marketing-and-sales": { enabled: true },
      "media-and-streaming": { enabled: true },
      moltbook: { enabled: true },
      "notes-and-pkm": { enabled: true },
      "pdf-and-documents": { enabled: true },
      "personal-development": { enabled: true },
      "productivity-and-tasks": { enabled: true },
      "search-and-research": { enabled: true },
      "security-and-passwords": { enabled: true },
      "self-hosted-and-automation": { enabled: true },
      "shopping-and-e-commerce": { enabled: true },
      "smart-home-and-iot": { enabled: true },
      "speech-and-transcription": { enabled: true },
      transportation: { enabled: true },
      "web-and-frontend-development": { enabled: true },
    },
  },
}
