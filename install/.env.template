# OpenClaw VPS — Venice AI deployment
# Generated by install-vps.sh — do not commit real keys

OPENCLAW_GATEWAY_TOKEN=__GATEWAY_TOKEN__

# Venice AI — OpenAI-compatible provider
OPENAI_API_KEY=__VENICE_API_KEY__
OPENAI_API_BASE=https://api.venice.ai/v1

# Optional: set default model (Venice AI model names)
# "venice-uncensored" is Venice's uncensored default text model.
OPENCLAW_DEFAULT_MODEL=venice-uncensored

# Telegram bot (human-language chat)
TELEGRAM_BOT_TOKEN=__TELEGRAM_BOT_TOKEN__

# State and config paths
OPENCLAW_STATE_DIR=/root/.openclaw
OPENCLAW_CONFIG_PATH=/root/.openclaw/openclaw.json
OPENCLAW_HOME=/root
