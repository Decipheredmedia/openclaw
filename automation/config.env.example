# =============================================================================
# OpenClaw Automation System — Complete Configuration Reference
# Copy this file to config.env and fill in every value before running.
# Lines starting with # are comments and are ignored by the loader.
# =============================================================================

# -----------------------------------------------------------------------------
# SECTION 1 — VPS / SERVER
# -----------------------------------------------------------------------------

# The public IPv4 address of your VPS (used by the installer for validation)
VPS_IP=203.0.113.10

# SSH user that owns the deployment (usually 'root' or a sudo-capable account)
VPS_USER=root

# Absolute path where openclaw is cloned on the VPS
OPENCLAW_DIR=/opt/openclaw

# Absolute path where the automation repo lives on the VPS
AUTOMATION_DIR=/opt/openclaw-automation

# Path to write logs
LOG_DIR=/var/log/openclaw-automation

# -----------------------------------------------------------------------------
# SECTION 2 — OPENCLAW
# -----------------------------------------------------------------------------

# URL of the openclaw git repository to clone
OPENCLAW_REPO=https://github.com/Decipheredmedia/openclaw

# Branch/tag to check out after cloning
OPENCLAW_BRANCH=main

# Port openclaw gateway listens on internally (default 18789)
OPENCLAW_PORT=18789

# The openclaw gateway bind address (loopback = safer; 0.0.0.0 = all interfaces)
OPENCLAW_BIND=127.0.0.1

# -----------------------------------------------------------------------------
# SECTION 3 — WEBSITES
# -----------------------------------------------------------------------------

# Comma-separated list of domain names to deploy (one site per domain).
# Each domain must already be pointed (DNS A record) to VPS_IP.
# Example: example.com,shop.example.com
SITE_DOMAINS=example.com

# For each domain in SITE_DOMAINS, optionally set a template name.
# Use the filename (without .html) from website_builder/templates/.
# Defaults to 'base' if not set.
# Format: domain1=template_name,domain2=template_name
SITE_TEMPLATES=example.com=base

# Short description of each site used by the AI content generator.
# Format: domain1=Description text,domain2=Description text
SITE_DESCRIPTIONS=example.com=A professional services website offering expert consulting

# Target audience for each site (used in social media content generation)
# Format: domain1=audience description,domain2=audience description
SITE_AUDIENCES=example.com=small business owners and entrepreneurs

# Webroot directory for Let's Encrypt HTTP-01 challenges
CERTBOT_WEBROOT=/var/www/certbot

# Email address for Let's Encrypt registration and expiry notices
CERTBOT_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# SECTION 4 — OPENAI (Website Builder + Social Content Generator)
# -----------------------------------------------------------------------------

# Your OpenAI API key (https://platform.openai.com/account/api-keys)
OPENAI_API_KEY=sk-proj-...

# Model to use for content generation (gpt-4o recommended)
OPENAI_MODEL=gpt-4o

# Maximum tokens per generation call
OPENAI_MAX_TOKENS=4096

# Temperature (0.0 = deterministic, 1.0 = creative). 0.7 works well for marketing.
OPENAI_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# SECTION 5 — STRIPE (Fiat Card Payments)
# -----------------------------------------------------------------------------

# Stripe publishable key (safe to embed in frontend HTML)
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe secret key (server-side only — NEVER commit this)
STRIPE_SECRET_KEY=sk_live_...

# Stripe webhook signing secret (obtained from Stripe Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Connect account ID if using Connect for payouts (leave blank for direct)
STRIPE_CONNECT_ACCOUNT_ID=

# Port for the local FastAPI payment webhook server
PAYMENT_SERVER_PORT=8000

# -----------------------------------------------------------------------------
# SECTION 6 — PAYPAL (Fiat Payments)
# -----------------------------------------------------------------------------

# PayPal REST API client ID (from https://developer.paypal.com/dashboard/)
PAYPAL_CLIENT_ID=...

# PayPal REST API secret
PAYPAL_SECRET=...

# PayPal environment: 'sandbox' for testing, 'live' for production
PAYPAL_ENV=live

# PayPal webhook ID (from PayPal Developer Dashboard → Webhooks)
PAYPAL_WEBHOOK_ID=...

# -----------------------------------------------------------------------------
# SECTION 7 — CRYPTO WALLETS
# -----------------------------------------------------------------------------

# Bitcoin (BTC) — Native SegWit (bech32) or legacy address
BTC_WALLET_ADDRESS=bc1q...

# Ethereum (ETH) — ERC-20 compatible wallet address (0x...)
ETH_WALLET_ADDRESS=0x...

# USDT on TRON (TRC-20) — starts with T
USDT_TRC20_WALLET_ADDRESS=T...

# Alchemy API key for ETH / ERC-20 monitoring (https://dashboard.alchemy.com/)
ALCHEMY_API_KEY=...

# TRON API key for TronGrid (https://www.trongrid.io/)
TRON_API_KEY=...

# Number of blockchain confirmations to require before notifying (BTC default: 2)
BTC_CONFIRMATIONS_REQUIRED=2
ETH_CONFIRMATIONS_REQUIRED=12
TRON_CONFIRMATIONS_REQUIRED=19

# How often (in seconds) to poll blockchain APIs for new transactions
CRYPTO_POLL_INTERVAL=60

# -----------------------------------------------------------------------------
# SECTION 8 — TELEGRAM BOT (Remote Management)
# -----------------------------------------------------------------------------

# Bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAF...

# Your personal Telegram numeric user ID (from @userinfobot).
# Only this user can issue commands to the bot.
TELEGRAM_OWNER_ID=987654321

# Comma-separated list of additional allowed Telegram user IDs (operators)
TELEGRAM_ALLOWED_IDS=987654321

# Telegram chat ID to send automated payment/alert notifications to
# (can be the same as TELEGRAM_OWNER_ID for DMs, or a group chat ID)
TELEGRAM_NOTIFY_CHAT_ID=987654321

# -----------------------------------------------------------------------------
# SECTION 9 — INSTAGRAM
# -----------------------------------------------------------------------------

# Instagram Graph API access token (long-lived, from Meta Developer Console)
INSTAGRAM_ACCESS_TOKEN=...

# Instagram Business Account ID (numeric, from Meta Developer Console)
INSTAGRAM_ACCOUNT_ID=...

# Path to default promotional image used when no site-specific image is found
# Must be an absolute path on the VPS, or a publicly accessible URL
INSTAGRAM_DEFAULT_IMAGE_URL=https://example.com/promo.jpg

# Comma-separated cron expressions per site for Instagram posting schedule
# Format: domain1=cron_expr,domain2=cron_expr  (standard 5-field cron)
# Example: post at 9 AM and 6 PM daily → '0 9,18 * * *'
INSTAGRAM_SCHEDULE=example.com=0 9 * * *

# Maximum posts per day (Instagram enforces 25; stay well under for safety)
INSTAGRAM_MAX_POSTS_PER_DAY=3

# -----------------------------------------------------------------------------
# SECTION 10 — REDDIT
# -----------------------------------------------------------------------------

# Reddit OAuth2 app credentials (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=openclaw-automation/1.0 by /u/your_reddit_username

# Comma-separated list of subreddits to post to (without r/)
REDDIT_SUBREDDITS=entrepreneur,smallbusiness,startups

# Minimum karma before the bot will post to a subreddit (safety check)
REDDIT_MIN_KARMA=10

# Minimum delay in hours between posts to the same subreddit
REDDIT_MIN_POST_INTERVAL_HOURS=24

# Random extra delay range in hours (post_interval + random(0, jitter))
REDDIT_JITTER_HOURS=6

# -----------------------------------------------------------------------------
# SECTION 11 — TWITTER / X
# -----------------------------------------------------------------------------

# Twitter API v2 credentials (https://developer.twitter.com/en/portal/dashboard)
TWITTER_API_KEY=...
TWITTER_API_SECRET=...
TWITTER_ACCESS_TOKEN=...
TWITTER_ACCESS_SECRET=...
TWITTER_BEARER_TOKEN=...

# Comma-separated cron expressions per site
TWITTER_SCHEDULE=example.com=0 12 * * *

# Whether to post as a thread when content exceeds 280 chars (true/false)
TWITTER_THREAD_ENABLED=true

# Maximum tweets per day across all sites (Twitter rate limits: 300/3h per app)
TWITTER_MAX_TWEETS_PER_DAY=10

# -----------------------------------------------------------------------------
# SECTION 12 — SOCIAL MEDIA GLOBAL
# -----------------------------------------------------------------------------

# Master switch to enable/disable all social posting (true/false)
SOCIAL_ENABLED=true

# Whether to log all generated content before posting (useful for review)
SOCIAL_DRY_RUN=false

# Path to store posted content IDs (to avoid duplicate posts)
SOCIAL_STATE_FILE=/var/lib/openclaw-automation/social_state.json
